# Strava API Credentials
# Retrieve these by registering an application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here

# Local redirect server port for OAuth callback
STRAVA_PORT=8282

# The authorization tokens will be automatically cached here by the authenticator script.
# Do not share or commit these to Git.
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_EXPIRES_AT=
